generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  PENDING_PAYMENT
  PAID
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  pdfFilePath String   @map("pdf_file_path")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("products")
}

model Order {
  id            Int         @id @default(autoincrement())
  productId     Int         @map("product_id")
  customerName  String      @map("customer_name")
  customerEmail String      @map("customer_email")
  totalAmount   Decimal     @db.Decimal(10, 2) @map("total_amount")
  status        OrderStatus @default(NEW)
  createdAt     DateTime    @default(now()) @map("created_at")

  product       Product        @relation(fields: [productId], references: [id])
  payment       Payment?
  paymentEvents PaymentEvent[]
  emailLogs     EmailLog[]

  @@map("orders")
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           Int           @unique @map("order_id")
  provider          String
  externalPaymentId String?       @map("external_payment_id")
  payuOrderId       String?       @map("payu_order_id")
  status            PaymentStatus @default(PENDING)
  confirmedAt       DateTime?     @map("confirmed_at")
  webhookReceivedAt DateTime?     @map("webhook_received_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model PaymentEvent {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  payuEventType String?  @map("payu_event_type")
  payuStatus    String?  @map("payu_status")
  rawPayload    Json     @map("raw_payload")
  receivedAt    DateTime @default(now()) @map("received_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payment_events")
}

model LeadStatus {
  id   Int    @id @default(autoincrement())
  name String @unique

  leads Lead[]

  @@map("lead_statuses")
}

model Lead {
  id              Int      @id @default(autoincrement())
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  email           String
  phone           String?
  trainingGoal    String   @map("training_goal")
  experienceLevel String   @map("experience_level")
  cooperationType String   @map("cooperation_type")
  healthData      Json?    @map("health_data")
  statusId        Int      @map("status_id")
  createdAt       DateTime @default(now()) @map("created_at")

  status    LeadStatus @relation(fields: [statusId], references: [id])
  emailLogs EmailLog[]

  @@map("leads")
}

model EmailLog {
  id             Int         @id @default(autoincrement())
  orderId         Int?        @map("order_id")
  leadId          Int?        @map("lead_id")
  recipientEmail String      @map("recipient_email")
  emailType       String      @map("email_type")
  resendId        String?     @map("resend_id")
  status          EmailStatus @default(PENDING)
  sentAt          DateTime?   @map("sent_at")

  order Order? @relation(fields: [orderId], references: [id])
  lead  Lead?  @relation(fields: [leadId], references: [id])

  @@map("email_logs")
}